PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartedu

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ML microservice (FastAPI wrapping the trained Random Forest model)
ML_SERVICE_URL=http://localhost:8001/predict
# Batch endpoint (defaults to ML_SERVICE_URL + "/batch")
# ML_BATCH_URL=http://localhost:8001/predict/batch

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Login rate limit (per IP): max attempts per window. Raise LOGIN_RATE_LIMIT_MAX locally
# (e.g. 200) so repeated test logins don't get blocked.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# Chat assistant ("Ask SmartEdu")
# Messages per minute per logged-in student
CHAT_RATE_LIMIT_PER_MIN=20
# Layer 2 (optional LLM for questions the templates can't match). Off by default; the app
# works fully without it. Never commit a real key.
CHAT_LLM_ENABLED=false
# anthropic (default) | gemini
CHAT_LLM_PROVIDER=anthropic
# used when CHAT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# used when CHAT_LLM_PROVIDER=gemini (Google AI Studio key)
GEMINI_API_KEY=
# Model: leave empty for the provider default - anthropic: claude-haiku-5-5;
# gemini: gemini-3.8-flash, the newest Flash model with a free tier ("Free of charge" on
# https://aistudio.google.com/docs/pricing, checked 2026-11-07). Free tier: Google may use
# prompts and answers to improve its products, so only send the SYNTHETIC dataset to it.
# Free-tier daily limits are low (see https://aistudio.google.com/rate-limit); a 429 falls
# back to the Layer 1 reply.
CHAT_LLM_MODEL=
# per request, no retries (both providers)
CHAT_LLM_TIMEOUT_MS=8000
