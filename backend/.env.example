PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartedu

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ML microservice (FastAPI wrapping the trained Random Forest model)
ML_SERVICE_URL=http://localhost:8001/predict
# Batch endpoint (defaults to ML_SERVICE_URL + "/batch")
# ML_BATCH_URL=http://localhost:8001/predict/batch

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Login rate limit (per IP): max attempts per window. Raise LOGIN_RATE_LIMIT_MAX locally
# (e.g. 200) so repeated test logins don't get blocked.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# Chat assistant ("Ask SmartEdu")
# Messages per minute per logged-in student
CHAT_RATE_LIMIT_PER_MIN=20
# Layer 2 (optional LLM for questions the templates can't match). Off by default; the app
# works fully without it. Needs an Anthropic API key - never commit a real key.
CHAT_LLM_ENABLED=false
ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-haiku-5-5
CHAT_LLM_TIMEOUT_MS=8000
